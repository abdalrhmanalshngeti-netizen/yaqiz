# ═══════════════════════════════════════════
# Yaqiz Production Environment
# انسخ هذا الملف إلى .env وعدّله
# ═══════════════════════════════════════════

NODE_ENV=production
PORT=3000

# PostgreSQL — غيّر القيم بعد التثبيت
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=yaqiz_db
DB_USER=yaqiz_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT — يجب أن يكون 64 حرفاً على الأقل وعشوائياً
# أنشئها بـ: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_RANDOM_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_RANDOM_CHARS

# CORS — دومين الموقع بعد الإطلاق
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ZATCA
ZATCA_ENV=production
ZATCA_API_URL=https://gw-fatoora.zatca.gov.sa/e-invoicing/developer-portal
