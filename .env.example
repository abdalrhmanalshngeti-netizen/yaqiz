# Server
NODE_ENV=development
PORT=3000
# التوقيت السعودي (UTC+3، بلا توقيت صيفي) — بلا هذا، new Date().getHours()/toTimeString()
# وأي طابع وقت محلي بالسيرفر (وقت إصدار فاتورة ZATCA تحديدًا) يعتمد توقيت
# الخادم الافتراضي (UTC غالبًا بمنصات الاستضافة)، لا التوقيت الفعلي بالسعودية
TZ=Asia/Riyadh

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=yaqiz_db
DB_USER=yaqiz_user
DB_PASSWORD=CHANGE_THIS_PASSWORD

# JWT -- generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERATE_RANDOM_128_CHAR_SECRET
JWT_REFRESH_SECRET=GENERATE_DIFFERENT_RANDOM_128_CHAR_SECRET
PERIOD_OVERRIDE_JWT_SECRET=GENERATE_DIFFERENT_RANDOM_128_CHAR_SECRET
# اختياري — توكنات لوحة إدارة المنصة (platform admin) كانت تشترك JWT_SECRET
# نفسه مع توكنات المستأجرين، بلا فصل تشفيري حقيقي. لو ضُبط هذا المتغير، تصير
# توكنات الإدمن موقّعة بسر مختلف تمامًا؛ لو تُرك فارغًا يستمر السلوك الحالي
# (fallback لـJWT_SECRET) بلا أي تغيير — لا إجبار خروج فوري لأي جلسة إدمن حالية
ADMIN_JWT_SECRET=GENERATE_DIFFERENT_RANDOM_128_CHAR_SECRET

# CORS
ALLOWED_ORIGINS=https://yourdomain.com

# ZATCA
ZATCA_ENV=mock

# Moyasar — اطلب المفاتيح من dashboard.moyasar.com
MOYASAR_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
MOYASAR_SECRET_KEY=sk_test_YOUR_KEY_HERE
APP_URL=https://yaqiz.me
